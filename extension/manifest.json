{
  "manifest_version": 3,
  "name": "Claude Conversations Exporter",
  "version": "1.0.0",
  "description": "Export Claude Project conversations or a single conversation as a structured Markdown zip.",
  "permissions": ["downloads", "activeTab", "cookies"],
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/project/*", "https://claude.ai/chat/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/chat/*"],
      "js": ["main-world-hook.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
