{
  "manifest_version": 3,
  "name": "LLM Vault",
  "version": "1.0.0",
  "description": "Export Claude Project conversations or a single conversation as a structured Markdown zip.",
  "permissions": ["downloads", "activeTab", "cookies", "sidePanel", "tabs"],
  "host_permissions": ["https://claude.ai/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/project/*", "https://claude.ai/chat/*", "https://claude.ai/projects", "https://claude.ai/recents", "https://claude.ai/cowork/project/*", "https://claude.ai/cowork/projects", "https://claude.ai/chats"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
