{
  "manifest_version": 3,
  "name": "LLM Vault — Claude & ChatGPT Exporter",
  "version": "1.3.0",
  "description": "Export Claude or ChatGPT Project conversations as structured Markdown zip files.",
  "permissions": [
    "downloads",
    "activeTab",
    "cookies",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/project/*",
        "https://claude.ai/chat/*",
        "https://claude.ai/projects",
        "https://claude.ai/recents",
        "https://claude.ai/cowork/project/*",
        "https://claude.ai/cowork/projects",
        "https://claude.ai/chats"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-gpt.js"],
      "run_at": "document_idle"
    }
  ]
}
